# Servidor
PORT=3000
# URL pública usada para montar o link das imagens (opcional; padrão: host da requisição)
BASE_URL=

# JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1h

# Banco de dados (mysql | sqlite)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_store
DB_USER=root
DB_PASSWORD=root
# Usado apenas quando DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Pasta onde as imagens dos produtos são salvas
UPLOAD_DIR=./uploads
